{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ultra-rag.local/contracts/exec.schema.json",
  "title": "KeyExecutionRequest",
  "type": "object",
  "additionalProperties": false,
  "required": ["command", "key_ids", "device_id", "host"],
  "properties": {
    "exec_id": {"type": "string", "pattern": "^exec_[0-9a-f]{32}$"},
    "command": {"type": "string", "minLength": 1},
    "key_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^key_[0-9a-f]{32}$"}},
    "device_id": {"type": "string", "pattern": "^dev_[0-9a-f]{32}$"},
    "host": {"enum": ["local", "pc", "server"]},
    "mode": {"enum": ["single", "resident"]},
    "timeout_seconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 86400},
    "session_id": {"type": ["string", "null"]},
    "cwd": {"type": ["string", "null"]},
    "deliverables": {
      "type": "array",
      "items": {"type": "string", "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$)).+$"}
    },
    "deliver_to": {"type": ["string", "null"]},
    "input_paths": {"type": "array", "items": {"type": "string"}},
    "created_at": {"type": "string"}
  }
}
