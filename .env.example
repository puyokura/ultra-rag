# Secret values only. Copy this file to `.env` beside it, then import:
#   python -m ultra_rag_cli.main --home <HOME> secret import-env .env \
#     --service <SERVICE> --purpose <PURPOSE>
#
# The importer reads this file locally and writes encrypted entries to the vault.
# Do not commit `.env`, and restrict it to the owner (chmod 600).
# Do not put non-secret settings here; use `.env.public` for those.
NVIDIA_API_KEY=replace-with-secret
CLOUDFLARE_API_TOKEN=replace-with-secret
