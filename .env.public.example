# Non-secret runtime settings. Copy this file to `.env.public` beside it.
# Never put API keys, passwords, tokens, private keys, or account IDs here.
#
# This project does not load `.env.public` automatically. Load it in the shell
# that starts the CLI or dsh:
#   set -a; . ./.env.public; set +a
#
# Values below are placeholders; replace them for the target host.
ULTRA_RAG_HTTP_BASE=http://127.0.0.1:8765
ULTRA_RAG_SYNC_REMOTE=http://127.0.0.1:8765
ULTRA_RAG_DEFAULT_MODEL=replace-with-model-name
ULTRA_RAG_TIMEOUT_SECONDS=60
